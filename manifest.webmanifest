{
  "id": "/",
  "name": "HD Video Player",
  "short_name": "VideoPlayer",
  "description": "Play YouTube links with queue and loop, and download videos from other sites.",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "entertainment",
    "utilities"
  ],
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f0ea",
  "theme_color": "#3f8f7d",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Paste a link",
      "short_name": "New link",
      "url": "/?source=shortcut#link",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Downloader",
      "short_name": "Downloader",
      "url": "/?source=shortcut#dl",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Your videos",
      "short_name": "Library",
      "url": "/?source=shortcut#library",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "video/*": [
          ".mp4",
          ".webm",
          ".mkv",
          ".mov",
          ".m4v"
        ],
        "audio/*": [
          ".mp3",
          ".m4a",
          ".aac",
          ".ogg",
          ".wav",
          ".flac"
        ]
      }
    }
  ]
}
